PORT=5173
HOST=127.0.0.1

# Comma-separated production origins, for example:
# ALLOWED_ORIGINS=https://code-review-agent.netlify.app
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Gemini is optional, but Version 2 uses it when this key is present.
# Use a Gemini Developer API free-tier key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Demo limits. These are session based and intentionally lightweight for V2.
SESSION_REVIEW_LIMIT=10
SESSION_GEMINI_LIMIT=10
SESSION_TOKEN_LIMIT=150000
REVIEW_PROMPT_TOKEN_LIMIT=8000
REVIEW_OUTPUT_TOKEN_LIMIT=4500
